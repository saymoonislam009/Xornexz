# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://xornexz.com
NODE_ENV=production

# ── Database (Neon) ───────────────────────────────────────────────────────────
# Pooled connection for runtime queries (use -pooler hostname)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct connection for migrations (no -pooler)
DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://xornexz.com

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=hello@xornexz.com
RESEND_FROM_NAME=Xornexz

# ── Cloudflare R2 (media) ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=xornexz-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Custom domain configured in Cloudflare (e.g. media.xornexz.com)
NEXT_PUBLIC_MEDIA_URL=https://media.xornexz.com
NEXT_PUBLIC_MEDIA_HOSTNAME=media.xornexz.com

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (optional bot protection on public forms) ─────────────
# Leave blank to disable Turnstile (honeypot + Upstash still protect forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cron (scheduled blog posts) ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Seed ──────────────────────────────────────────────────────────────────────
# Used ONLY by prisma/seed.ts — not loaded at runtime
ADMIN_EMAIL=admin@xornexz.com
ADMIN_PASSWORD=ChangeMe123!

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Plausible: set domain to enable
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4: set measurement ID to enable  
NEXT_PUBLIC_GA_ID=
